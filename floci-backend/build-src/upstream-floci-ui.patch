diff --git a/packages/api/src/adapter-aws/AwsApplicationAutoScalingAdapter.ts b/packages/api/src/adapter-aws/AwsApplicationAutoScalingAdapter.ts
new file mode 100644
index 0000000..958d7b1
--- /dev/null
+++ b/packages/api/src/adapter-aws/AwsApplicationAutoScalingAdapter.ts
@@ -0,0 +1,156 @@
+import {
+    DeregisterScalableTargetCommand,
+    DescribeScalableTargetsCommand,
+    RegisterScalableTargetCommand,
+    ServiceNamespace,
+    type ApplicationAutoScalingClient,
+    type ScalableTarget,
+} from '@aws-sdk/client-application-auto-scaling'
+import {awsApplicationAutoScalingSchema} from '../cloud-spi/applicationAutoScalingSchema'
+import {NotFoundError, RuntimeError, ValidationError} from '../cloud-spi/errors'
+import type {CloudResource, CloudServiceAdapter, CreateResourceInput, ResourceQuery, ServiceSchema} from '../cloud-spi/types'
+
+const ALL_NAMESPACES = Object.values(ServiceNamespace)
+const ID_SEPARATOR = '|'
+
+function toId(target: Pick<ScalableTarget, 'ServiceNamespace' | 'ScalableDimension' | 'ResourceId'>): string {
+    return [target.ServiceNamespace, target.ScalableDimension, target.ResourceId].join(ID_SEPARATOR)
+}
+
+function parseId(id: string): {serviceNamespace: ServiceNamespace; scalableDimension: string; resourceId: string} {
+    const [serviceNamespace, scalableDimension, resourceId] = id.split(ID_SEPARATOR)
+    if (!serviceNamespace || !scalableDimension || !resourceId) {
+        throw new ValidationError(`Not a valid scalable target id: ${id}`)
+    }
+    return {serviceNamespace: serviceNamespace as ServiceNamespace, scalableDimension, resourceId}
+}
+
+function toResource(target: ScalableTarget): CloudResource {
+    return {
+        id: toId(target),
+        name: target.ResourceId ?? '',
+        cloud: 'aws',
+        service: 'autoscaling',
+        type: 'scalable-target',
+        region: null,
+        createdAt: target.CreationTime?.toISOString() ?? null,
+        metadata: {
+            provider: 'aws',
+            serviceNamespace: target.ServiceNamespace,
+            scalableDimension: target.ScalableDimension,
+            minCapacity: target.MinCapacity ?? null,
+            maxCapacity: target.MaxCapacity ?? null,
+            roleArn: target.RoleARN ?? null,
+            scalableTargetArn: target.ScalableTargetARN ?? null,
+        },
+    }
+}
+
+function requiredString(value: unknown, field: string): string {
+    if (typeof value !== 'string' || value.trim() === '') throw new ValidationError(`${field} is required`)
+    return value.trim()
+}
+
+function requiredInt(value: unknown, field: string): number {
+    const parsed = typeof value === 'number' ? value : Number(value)
+    if (!Number.isInteger(parsed) || parsed < 0) throw new ValidationError(`${field} must be a non-negative integer`)
+    return parsed
+}
+
+/** AWS Application Auto Scaling's scalable targets. There is no single list-everything
+ * API — `DescribeScalableTargets` always scopes to one `ServiceNamespace` — so `list`
+ * fans out across every namespace the SDK knows about and merges the results. */
+export class AwsApplicationAutoScalingAdapter implements CloudServiceAdapter {
+    readonly cloud = 'aws' as const
+    readonly service = 'autoscaling' as const
+
+    constructor(private readonly client: ApplicationAutoScalingClient) {}
+
+    schema(): ServiceSchema {
+        return awsApplicationAutoScalingSchema()
+    }
+
+    async list(query: ResourceQuery = {}): Promise<CloudResource[]> {
+        const results = await Promise.all(
+            ALL_NAMESPACES.map((namespace) => this.listNamespace(namespace)),
+        )
+        const targets = results.flat()
+        const search = query.search?.trim().toLowerCase()
+        return search ? targets.filter((t) => t.name.toLowerCase().includes(search)) : targets
+    }
+
+    private async listNamespace(serviceNamespace: ServiceNamespace): Promise<CloudResource[]> {
+        const targets: ScalableTarget[] = []
+        let nextToken: string | undefined
+        do {
+            const res = await this.client.send(
+                new DescribeScalableTargetsCommand({ServiceNamespace: serviceNamespace, NextToken: nextToken}),
+            )
+            targets.push(...(res.ScalableTargets ?? []))
+            nextToken = res.NextToken
+        } while (nextToken)
+        return targets.map(toResource)
+    }
+
+    async get(id: string): Promise<CloudResource | null> {
+        const {serviceNamespace, scalableDimension, resourceId} = parseId(id)
+        const res = await this.client.send(
+            new DescribeScalableTargetsCommand({
+                ServiceNamespace: serviceNamespace,
+                ResourceIds: [resourceId],
+                ScalableDimension: scalableDimension as never,
+            }),
+        )
+        const target = res.ScalableTargets?.[0]
+        return target ? toResource(target) : null
+    }
+
+    async create(input: CreateResourceInput): Promise<CloudResource> {
+        const serviceNamespace = requiredString(input.values.serviceNamespace, 'serviceNamespace') as ServiceNamespace
+        const resourceId = requiredString(input.values.resourceId, 'resourceId')
+        const scalableDimension = requiredString(input.values.scalableDimension, 'scalableDimension')
+        const minCapacity = requiredInt(input.values.minCapacity, 'minCapacity')
+        const maxCapacity = requiredInt(input.values.maxCapacity, 'maxCapacity')
+        if (maxCapacity < minCapacity) throw new ValidationError('maxCapacity must be at least minCapacity')
+        const roleArn = typeof input.values.roleArn === 'string' && input.values.roleArn.trim() !== ''
+            ? input.values.roleArn.trim()
+            : undefined
+
+        await this.client.send(
+            new RegisterScalableTargetCommand({
+                ServiceNamespace: serviceNamespace,
+                ResourceId: resourceId,
+                ScalableDimension: scalableDimension as never,
+                MinCapacity: minCapacity,
+                MaxCapacity: maxCapacity,
+                ...(roleArn ? {RoleARN: roleArn} : {}),
+            }),
+        )
+
+        const created = await this.get(toId({ServiceNamespace: serviceNamespace, ScalableDimension: scalableDimension as never, ResourceId: resourceId}))
+        if (!created) throw new RuntimeError(`Scalable target ${resourceId} was registered but could not be read back`)
+        return created
+    }
+
+    async delete(id: string): Promise<void> {
+        const {serviceNamespace, scalableDimension, resourceId} = parseId(id)
+        try {
+            await this.client.send(
+                new DeregisterScalableTargetCommand({
+                    ServiceNamespace: serviceNamespace,
+                    ResourceId: resourceId,
+                    ScalableDimension: scalableDimension as never,
+                }),
+            )
+        } catch (error) {
+            if (isMissing(error)) throw new NotFoundError(`Scalable target ${id} not found`)
+            throw error
+        }
+    }
+}
+
+function isMissing(error: unknown): boolean {
+    if (!error || typeof error !== 'object') return false
+    const value = error as {name?: string}
+    return value.name === 'ObjectNotFoundException'
+}
diff --git a/packages/api/src/cloud-spi/applicationAutoScalingSchema.ts b/packages/api/src/cloud-spi/applicationAutoScalingSchema.ts
new file mode 100644
index 0000000..22e604e
--- /dev/null
+++ b/packages/api/src/cloud-spi/applicationAutoScalingSchema.ts
@@ -0,0 +1,96 @@
+import type {ServiceSchema} from './types'
+
+const SERVICE_NAMESPACES = [
+    'dynamodb', 'ecs', 'ec2', 'elasticmapreduce', 'appstream', 'rds', 'sagemaker',
+    'custom-resource', 'comprehend', 'lambda', 'cassandra', 'kafka', 'elasticache',
+    'neptune', 'workspaces',
+] as const
+
+const SCALABLE_DIMENSIONS = [
+    'dynamodb:table:ReadCapacityUnits', 'dynamodb:table:WriteCapacityUnits',
+    'dynamodb:index:ReadCapacityUnits', 'dynamodb:index:WriteCapacityUnits',
+    'ecs:service:DesiredCount', 'ec2:spot-fleet-request:TargetCapacity',
+    'elasticmapreduce:instancegroup:InstanceCount', 'appstream:fleet:DesiredCapacity',
+    'rds:cluster:ReadReplicaCount', 'sagemaker:variant:DesiredInstanceCount',
+    'sagemaker:variant:DesiredProvisionedConcurrency', 'sagemaker:inference-component:DesiredCopyCount',
+    'custom-resource:ResourceType:Property', 'comprehend:document-classifier-endpoint:DesiredInferenceUnits',
+    'comprehend:entity-recognizer-endpoint:DesiredInferenceUnits',
+    'lambda:function:ProvisionedConcurrency', 'cassandra:table:ReadCapacityUnits',
+    'cassandra:table:WriteCapacityUnits', 'kafka:broker-storage:VolumeSize',
+    'elasticache:cache-cluster:Nodes', 'elasticache:replication-group:NodeGroups',
+    'elasticache:replication-group:Replicas', 'neptune:cluster:ReadReplicaCount',
+    'workspaces:workspacespool:DesiredUserSessions',
+] as const
+
+export function awsApplicationAutoScalingSchema(): ServiceSchema {
+    return {
+        cloud: 'aws',
+        service: 'autoscaling',
+        displayName: 'Application Auto Scaling',
+        fields: [
+            {
+                name: 'serviceNamespace',
+                label: 'Service Namespace',
+                type: 'select',
+                required: true,
+                description: 'The AWS service that owns the resource to scale.',
+                options: SERVICE_NAMESPACES.map((ns) => ({label: ns, value: ns})),
+            },
+            {
+                name: 'resourceId',
+                label: 'Resource ID',
+                type: 'text',
+                required: true,
+                description: 'The scalable resource, e.g. table/my-table or service/my-cluster/my-service.',
+                validation: {maxLength: 1600},
+            },
+            {
+                name: 'scalableDimension',
+                label: 'Scalable Dimension',
+                type: 'select',
+                required: true,
+                options: SCALABLE_DIMENSIONS.map((dim) => ({label: dim, value: dim})),
+            },
+            {
+                name: 'minCapacity',
+                label: 'Min Capacity',
+                type: 'text',
+                required: true,
+                defaultValue: '1',
+                validation: {pattern: '^[0-9]+$', message: 'Must be a non-negative integer.'},
+            },
+            {
+                name: 'maxCapacity',
+                label: 'Max Capacity',
+                type: 'text',
+                required: true,
+                defaultValue: '1',
+                validation: {pattern: '^[0-9]+$', message: 'Must be a non-negative integer.'},
+            },
+            {
+                name: 'roleArn',
+                label: 'IAM Role ARN',
+                type: 'text',
+                required: false,
+                description: 'Optional service-linked or custom role used to scale the resource.',
+            },
+        ],
+        actions: ['list', 'create', 'inspect', 'delete'],
+        filters: [{name: 'search', label: 'Search', type: 'text', required: false}],
+        columns: [
+            {name: 'name', label: 'Resource'},
+            {name: 'serviceNamespace', label: 'Namespace', path: 'metadata.serviceNamespace'},
+            {name: 'scalableDimension', label: 'Dimension', path: 'metadata.scalableDimension'},
+            {name: 'minCapacity', label: 'Min', path: 'metadata.minCapacity'},
+            {name: 'maxCapacity', label: 'Max', path: 'metadata.maxCapacity'},
+        ],
+        capabilities: {
+            resourceActions: [
+                {name: 'list', label: 'List scalable targets', enabled: true, status: 'available', runtimeRequired: true},
+                {name: 'create', label: 'Register scalable target', enabled: true, status: 'available', runtimeRequired: true},
+                {name: 'inspect', label: 'Inspect scalable target', enabled: true, status: 'available', runtimeRequired: true},
+                {name: 'delete', label: 'Deregister scalable target', enabled: true, status: 'available', runtimeRequired: true},
+            ],
+        },
+    }
+}
