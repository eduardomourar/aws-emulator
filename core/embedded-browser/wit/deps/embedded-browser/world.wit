package aws-emulator:embedded-browser@0.1.0;

/// The "core" component's world: the standard `wasi:http/proxy` world (so a host
/// delivers it incoming HTTP requests the same way any proxy component is served),
/// plus one extra import for calling out to a service split into another component.
world core {
  include wasi:http/proxy@0.2.12;

  import aws-emulator:callback/dispatch@0.1.0;
}
